APP_NAME=Space Consultant AI Studio
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./studio.db
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
OUTPUT_DIR=generated
MAX_UPLOAD_MB=15
# Only needed for "AI Motion per scene" / image-to-video
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_VIDEO_VERSION=
# Only needed for the "generate script" feature
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Leave as ffmpeg. If FFmpeg is not installed, the bundled one (imageio-ffmpeg) is used automatically.
FFMPEG_BIN=ffmpeg
